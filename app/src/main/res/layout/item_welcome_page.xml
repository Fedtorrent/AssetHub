<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/text_welcome_top_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="BENVENUTO"
        android:textColor="#448AFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/img_welcome"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/text_welcome_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Titolo"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/text_welcome_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Versione 1.2"
        android:textColor="#BBBBBB"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text_welcome_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Descrizione della funzione o dell'app"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:lineHeight="18sp" />

    <View
        android:id="@+id/divider_welcome"
        android:layout_width="100dp"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="#448AFF"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/img_welcome2"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:src="@android:drawable/ic_menu_sort_by_size"
        app:tint="#BBBBBB"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text_welcome_title2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Titolo 2"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text_welcome_desc2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Descrizione 2"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:lineHeight="18sp"
        android:visibility="gone" />

    <View
        android:id="@+id/divider_welcome2"
        android:layout_width="80dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#448AFF"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/img_welcome3"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        app:tint="#BBBBBB"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text_welcome_title3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Titolo 3"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text_welcome_desc3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Descrizione 3"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:lineHeight="18sp"
        android:visibility="gone" />

    <!-- Nuovo blocco: List Item (Icona a sinistra, Testo a destra) -->
    <LinearLayout
        android:id="@+id/layout_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="start|top"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/img_list_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            app:tint="@color/azure_primary" />

        <TextView
            android:id="@+id/text_list_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:lineHeight="20sp" />
    </LinearLayout>

    <!-- Secondo blocco List Item -->
    <LinearLayout
        android:id="@+id/layout_list_item2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="start|top"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/img_list_icon2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            app:tint="@color/azure_primary" />

        <TextView
            android:id="@+id/text_list_content2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:lineHeight="20sp" />
    </LinearLayout>

</LinearLayout>