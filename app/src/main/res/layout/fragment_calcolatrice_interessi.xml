<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Capitale -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_capitale"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxBackgroundColor="@color/input_background"
            app:boxStrokeColor="@color/yellow_utility"
            app:boxStrokeWidth="2dp"
            app:hintTextColor="@color/yellow_utility">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_capitale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Capitale Investito (€)"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tasso annuo lordo -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_tasso"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxBackgroundColor="@color/input_background"
            app:boxStrokeColor="@color/yellow_utility"
            app:boxStrokeWidth="2dp"
            app:hintTextColor="@color/yellow_utility">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_tasso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tasso Annuo Lordo (%)"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Durata in mesi -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_durata"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxBackgroundColor="@color/input_background"
            app:boxStrokeColor="@color/yellow_utility"
            app:boxStrokeWidth="2dp"
            app:hintTextColor="@color/yellow_utility">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_durata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Durata (Mesi)"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tassazione -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundColor="@color/input_background"
            app:boxStrokeColor="@color/yellow_utility"
            app:boxStrokeWidth="2dp"
            app:hintTextColor="@color/yellow_utility">

            <AutoCompleteTextView
                android:id="@+id/spinner_tassazione"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tassazione"
                android:inputType="none"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Pulsante Calcola -->
        <Button
            android:id="@+id/btn_calcola"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/yellow_utility"
            android:text="CALCOLA INTERESSI"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Risultati -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_risultati"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/yellow_utility"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Risultati del Calcolo"
                    android:textColor="@color/yellow_utility"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="2dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Interessi Lordi:"
                        android:textColor="#BBBBBB"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/text_lordo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="2dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tassazione / Imposte:"
                        android:textColor="#BBBBBB"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/text_tassazione_importo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#F44336"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="#333333" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="2dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Interessi Netti:"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/text_netto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#4CAF50"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="2dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Capitale Finale Netto:"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/text_capitale_finale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#4CAF50"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="2dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tasso Annuo Netto:"
                        android:textColor="#BBBBBB"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/text_tasso_netto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="* al lordo di eventuale imposta di bollo"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:textStyle="italic" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
