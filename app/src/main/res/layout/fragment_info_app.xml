<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/text_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ASSET HUB"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Versione 1.3.1"
            android:textColor="#BBBBBB"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#333333" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SVILUPPATORE"
            android:textColor="#448AFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Il centro di controllo definitivo per il tuo patrimonio. Asset Hub nasce per fornire uno strumento chiaro e immediato per monitorare, pianificare e gestire ogni tuo asset in un unico luogo sicuro, garantendo una visione completa della tua libertà finanziaria."
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="PRIVACY E DATI"
            android:textColor="#448AFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="La tua privacy è la nostra priorità. Tutti i dati inseriti all'interno dell'applicazione risiedono esclusivamente nella memoria locale del tuo dispositivo. Nessun dato viene inviato a server esterni o terze parti per finalità di profilazione. L'applicazione non richiede accesso alla rete internet per il suo funzionamento core. I file di backup eventualmente esportati sono sotto la tua esclusiva responsabilità e, qualora decidessi di caricarli su servizi cloud (come Google Drive, Dropbox, ecc.), saranno conservati unicamente all'interno del tuo spazio privato personale."
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="24dp"
            android:background="#333333" />

        <LinearLayout
            android:id="@+id/layout_developer_site"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="SVILUPPATO DA"
                android:textColor="#888888"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:adjustViewBounds="true"
                android:contentDescription="Firma Programmatore"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_personal" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_site_badge"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VISITA IL SITO"
                    android:textColor="@color/azure_primary"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="4dp"
                    android:src="@android:drawable/ic_menu_send"
                    android:rotation="-45"
                    app:tint="@color/azure_primary" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
